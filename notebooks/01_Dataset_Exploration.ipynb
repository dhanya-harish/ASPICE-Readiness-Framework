# Import Required Libraries
from pydriller import Repository
import pandas as pd
import numpy as np
from jira import JIRA
import requests
import json
from datetime import datetime, timedelta
import os
import re

# ============================================================================
# CONFIGURATION
# ============================================================================

REPO_URLS = [
    'https://github.com/ApolloAuto/apollo',
    'https://github.com/autowarefoundation/autoware',
    'https://github.com/eclipse/openpass',
    'https://github.com/eclipse/sumo'
]

JIRA_SERVER = 'https://jira.public-domain.com'
JIRA_PROJECTS = ['PROJ1', 'PROJ2', 'PROJ3']

CI_LOGS_PATH = './data/ci_logs/'

OUTPUT_PATH = './data/processed/'

# ============================================================================
# FUNCTION 1: EXTRACT COMMIT DATA FROM GIT
# ============================================================================

def extract_commit_data(repo_url, since_date=None):
    """
    Extract commit data from Git repository using PyDriller.
    
    Parameters:
    -----------
    repo_url : str
        URL of the Git repository
    since_date : datetime, optional
        Extract commits since this date
    
    Returns:
    --------
    pandas.DataFrame: DataFrame with commit metrics
    """
    
    commits_data = []
    
    try:
        # Initialize repository
        repo = Repository(repo_url, since=since_date)
        
        # Iterate through commits
        for commit in repo.traverse_commits():
            commit_dict = {
                'hash': commit.hash,
                'author': commit.author.name,
                'author_email': commit.author.email,
                'committer_date': commit.committer_date,
                'author_date': commit.author_date,
                'message': commit.msg,
                'lines_added': commit.insertions,
                'lines_deleted': commit.deletions,
                'lines_modified': commit.modifications,
                'num_files': len(commit.modified_files),
                'num_parents': len(commit.parents),
                'merge_commit': len(commit.parents) > 1,
                'branches': commit.branches if hasattr(commit, 'branches') else []
            }
            
            # File-level details
            file_details = []
            for file in commit.modified_files:
                file_details.append({
                    'filename': file.filename,
                    'change_type': file.change_type.name,
                    'lines_added': file.added_lines,
                    'lines_deleted': file.deleted_lines,
                    'complexity': file.complexity if hasattr(file, 'complexity') else None
                })
            
            commit_dict['files'] = file_details
            commits_data.append(commit_dict)
            
    except Exception as e:
        print(f"Error extracting from {repo_url}: {e}")
    
    return pd.DataFrame(commits_data)

# ============================================================================
# FUNCTION 2: EXTRACT ISSUE DATA FROM JIRA
# ============================================================================

def extract_jira_data(jira_server, projects, username=None, password=None):
    """
    Extract issue data from Jira using JIRA API.
    
    Parameters:
    -----------
    jira_server : str
        Jira server URL
    projects : list
        List of project keys
    username : str, optional
        Jira username
    password : str, optional
        Jira password
    
    Returns:
    --------
    pandas.DataFrame: DataFrame with issue metrics
    """
    
    issues_data = []
    
    try:
        # Connect to Jira
        if username and password:
            jira = JIRA(server=jira_server, basic_auth=(username, password))
        else:
            jira = JIRA(server=jira_server)
        
        for project in projects:
            # Search for issues
            jql = f'project="{project}"'
            issues = jira.search_issues(jql, maxResults=10000)
            
            for issue in issues:
                issue_dict = {
                    'issue_key': issue.key,
                    'project': project,
                    'issue_type': issue.fields.issuetype.name,
                    'summary': issue.fields.summary,
                    'status': issue.fields.status.name,
                    'priority': issue.fields.priority.name if issue.fields.priority else None,
                    'severity': issue.fields.customfield_10001 if hasattr(issue.fields, 'customfield_10001') else None,
                    'created': issue.fields.created,
                    'updated': issue.fields.updated,
                    'resolved': issue.fields.resolutiondate if hasattr(issue.fields, 'resolutiondate') else None,
                    'resolution': issue.fields.resolution.name if issue.fields.resolution else None,
                    'assignee': issue.fields.assignee.name if issue.fields.assignee else None,
                    'reporter': issue.fields.reporter.name if issue.fields.reporter else None,
                    'comments': len(issue.fields.comment.comments) if hasattr(issue.fields, 'comment') else 0,
                    'attachments': len(issue.fields.attachment) if hasattr(issue.fields, 'attachment') else 0,
                    'subtasks': len(issue.fields.subtasks) if hasattr(issue.fields, 'subtasks') else 0,
                    'linked_issues': issue.fields.issuelinks if hasattr(issue.fields, 'issuelinks') else []
                }
                
                # Workflow events
                if hasattr(issue, 'changelog'):
                    workflow_events = []
                    for history in issue.changelog.histories:
                        for item in history.items:
                            workflow_events.append({
                                'author': history.author.name,
                                'created': history.created,
                                'field': item.field,
                                'from_value': item.fromString,
                                'to_value': item.toString
                            })
                    issue_dict['workflow_events'] = workflow_events
                
                issues_data.append(issue_dict)
                
    except Exception as e:
        print(f"Error extracting from Jira: {e}")
    
    return pd.DataFrame(issues_data)

# ============================================================================
# FUNCTION 3: EXTRACT CI/CD DATA
# ============================================================================

def extract_ci_data(ci_logs_path):
    """
    Extract CI/CD data from log files.
    
    Parameters:
    -----------
    ci_logs_path : str
        Path to CI/CD log directory
    
    Returns:
    --------
    pandas.DataFrame: DataFrame with CI/CD metrics
    """
    
    ci_data = []
    
    try:
        for log_file in os.listdir(ci_logs_path):
            if log_file.endswith('.log') or log_file.endswith('.json'):
                filepath = os.path.join(ci_logs_path, log_file)
                
                with open(filepath, 'r') as f:
                    if log_file.endswith('.json'):
                        data = json.load(f)
                        # Parse JSON data
                        for entry in data:
                            ci_data.append({
                                'build_id': entry.get('build_id'),
                                'timestamp': entry.get('timestamp'),
                                'status': entry.get('status'),
                                'duration': entry.get('duration'),
                                'test_count': entry.get('test_count'),
                                'test_passed': entry.get('test_passed'),
                                'test_failed': entry.get('test_failed'),
                                'coverage': entry.get('coverage'),
                                'deployment': entry.get('deployment')
                            })
                    else:
                        # Parse log file
                        lines = f.readlines()
                        # Custom parsing logic based on log format
                        for line in lines:
                            if 'BUILD' in line:
                                match = re.search(r'BUILD (SUCCESS|FAILED)', line)
                                if match:
                                    ci_data.append({
                                        'build_status': match.group(1),
                                        'timestamp': datetime.now().isoformat()
                                    })
                                    
    except Exception as e:
        print(f"Error extracting CI data: {e}")
    
    return pd.DataFrame(ci_data)

# ============================================================================
# FUNCTION 4: EXTRACT TEST DATA
# ============================================================================

def extract_test_data(test_reports_path):
    """
    Extract test data from test reports.
    
    Parameters:
    -----------
    test_reports_path : str
        Path to test reports directory
    
    Returns:
    --------
    pandas.DataFrame: DataFrame with test metrics
    """
    
    test_data = []
    
    try:
        for report_file in os.listdir(test_reports_path):
            if report_file.endswith('.xml') or report_file.endswith('.json'):
                filepath = os.path.join(test_reports_path, report_file)
                
                if report_file.endswith('.json'):
                    with open(filepath, 'r') as f:
                        data = json.load(f)
                        test_data.append({
                            'timestamp': data.get('timestamp'),
                            'total_tests': data.get('total'),
                            'passed': data.get('passed'),
                            'failed': data.get('failed'),
                            'skipped': data.get('skipped'),
                            'coverage': data.get('coverage'),
                            'duration': data.get('duration')
                        })
                else:
                    # Parse XML (JUnit format)
                    import xml.etree.ElementTree as ET
                    tree = ET.parse(filepath)
                    root = tree.getroot()
                    
                    total = 0
                    failed = 0
                    skipped = 0
                    
                    for testsuite in root.findall('testsuite'):
                        total += int(testsuite.get('tests', 0))
                        failed += int(testsuite.get('failures', 0))
                        skipped += int(testsuite.get('skipped', 0))
                    
                    test_data.append({
                        'timestamp': datetime.now().isoformat(),
                        'total_tests': total,
                        'failed': failed,
                        'skipped': skipped,
                        'passed': total - failed - skipped
                    })
                    
    except Exception as e:
        print(f"Error extracting test data: {e}")
    
    return pd.DataFrame(test_data)

# ============================================================================
# FUNCTION 5: COMPUTE PROCESS METRICS
# ============================================================================

def compute_process_metrics(df_commits, df_issues, df_ci, df_tests):
    """
    Compute software engineering process metrics from raw data.
    
    Parameters:
    -----------
    df_commits : pandas.DataFrame
        Commit data
    df_issues : pandas.DataFrame
        Issue data
    df_ci : pandas.DataFrame
        CI/CD data
    df_tests : pandas.DataFrame
        Test data
    
    Returns:
    --------
    pandas.DataFrame: DataFrame with computed process metrics
    """
    
    metrics = {}
    
    # Commit Metrics
    if not df_commits.empty:
        df_commits['date'] = pd.to_datetime(df_commits['committer_date'])
        
        # Weekly aggregation
        df_commits['week'] = df_commits['date'].dt.to_period('W')
        weekly = df_commits.groupby('week').agg({
            'hash': 'count',
            'lines_added': 'sum',
            'lines_deleted': 'sum',
            'num_files': 'mean'
        }).reset_index()
        
        metrics['commit_frequency'] = weekly['hash'].mean()
        metrics['commit_size'] = (weekly['lines_added'] + weekly['lines_deleted']).mean()
        metrics['code_churn'] = (weekly['lines_added'] + weekly['lines_deleted']).sum()
        metrics['files_per_commit'] = weekly['num_files'].mean()
        metrics['commit_regularity'] = df_commits['date'].diff().dt.days.std()
    
    # Issue Metrics
    if not df_issues.empty:
        df_issues['created'] = pd.to_datetime(df_issues['created'])
        df_issues['resolved'] = pd.to_datetime(df_issues['resolved'])
        
        # Resolution time
        df_issues['resolution_time'] = (df_issues['resolved'] - df_issues['created']).dt.total_seconds() / 60
        
        metrics['issue_resolution_time'] = df_issues['resolution_time'].mean()
        metrics['issue_reopen_rate'] = (df_issues['status'] == 'Reopened').mean()
        metrics['issue_aging'] = (pd.Timestamp.now() - df_issues['created']).mean().total_seconds() / 60
        metrics['comments_per_issue'] = df_issues['comments'].mean()
    
    # CI/CD Metrics
    if not df_ci.empty:
        metrics['build_success_rate'] = (df_ci['status'] == 'SUCCESS').mean()
        metrics['build_frequency'] = df_ci.groupby(df_ci['timestamp'].dt.to_period('W')).size().mean()
    
    # Test Metrics
    if not df_tests.empty:
        metrics['test_coverage'] = df_tests['coverage'].mean()
        metrics['test_failure_rate'] = df_tests['failed'].sum() / df_tests['total_tests'].sum()
        metrics['test_execution_time'] = df_tests['duration'].mean()
    
    return pd.DataFrame([metrics])

# ============================================================================
# FUNCTION 6: MAP METRICS TO ASPICE INDICATORS
# ============================================================================

def map_to_aspice_indicators(df_metrics):
    """
    Map process metrics to ASPICE readiness indicators.
    
    Parameters:
    -----------
    df_metrics : pandas.DataFrame
        DataFrame with process metrics
    
    Returns:
    --------
    pandas.DataFrame: DataFrame with ASPICE indicators
    """
    
    indicators = {}
    
    # SWE.1 - Requirements Analysis
    indicators['bp_SWE_1_compliance'] = df_metrics['requirement_traceability'].apply(
        lambda x: 1 if x > df_metrics['requirement_traceability'].median() else 0
    )
    
    # SWE.4 - Unit Verification
    indicators['bp_SWE_4_compliance'] = df_metrics.apply(
        lambda row: 1 if row['test_coverage'] > 0.7 and row['test_failure_rate'] < 0.2 else 0,
        axis=1
    )
    
    # SWE.5 - Integration and Integration Testing
    indicators['bp_SWE_5_compliance'] = df_metrics.apply(
        lambda row: 1 if row['pr_merge_time'] < df_metrics['pr_merge_time'].median() 
        and row['pr_acceptance_rate'] > 0.7 else 0,
        axis=1
    )
    
    # SUP.1 - Quality Assurance
    indicators['bp_SUP_1_compliance'] = df_metrics['issue_reopen_rate'].apply(
        lambda x: 1 if x < 0.15 else 0
    )
    
    # Composite Readiness Score
    indicators['aspice_readiness_score'] = (
        indicators['bp_SWE_1_compliance'] * 0.25 +
        indicators['bp_SWE_4_compliance'] * 0.25 +
        indicators['bp_SWE_5_compliance'] * 0.25 +
        indicators['bp_SUP_1_compliance'] * 0.25
    )
    
    # Readiness Level
    indicators['aspice_readiness_level'] = indicators['aspice_readiness_score'].apply(
        lambda x: 'High' if x > 0.7 else ('Moderate' if x > 0.4 else 'Low')
    )
    
    return pd.DataFrame(indicators)

# ============================================================================
# MAIN EXECUTION PIPELINE
# ============================================================================

def main():
    """
    Main execution function for the data extraction pipeline.
    """
    
    print("=" * 60)
    print("ASPICE Readiness Data Extraction Pipeline")
    print("=" * 60)
    
    # Step 1: Extract commit data
    print("\n[1/5] Extracting commit data from Git repositories...")
    df_commits_all = pd.DataFrame()
    for repo_url in REPO_URLS:
        df_commits = extract_commit_data(repo_url, since_date=datetime.now() - timedelta(days=365))
        df_commits_all = pd.concat([df_commits_all, df_commits], ignore_index=True)
    print(f"  ✓ Extracted {len(df_commits_all)} commits")
    
    # Step 2: Extract issue data
    print("\n[2/5] Extracting issue data from Jira...")
    df_issues_all = pd.DataFrame()
    df_issues_all = extract_jira_data(JIRA_SERVER, JIRA_PROJECTS)
    print(f"  ✓ Extracted {len(df_issues_all)} issues")
    
    # Step 3: Extract CI/CD data
    print("\n[3/5] Extracting CI/CD data...")
    df_ci_all = extract_ci_data(CI_LOGS_PATH)
    print(f"  ✓ Extracted {len(df_ci_all)} CI/CD records")
    
    # Step 4: Extract test data
    print("\n[4/5] Extracting test data...")
    df_tests_all = extract_test_data('./data/test_reports/')
    print(f"  ✓ Extracted {len(df_tests_all)} test records")
    
    # Step 5: Compute process metrics
    print("\n[5/5] Computing process metrics...")
    df_metrics = compute_process_metrics(df_commits_all, df_issues_all, df_ci_all, df_tests_all)
    print(f"  ✓ Computed {len(df_metrics.columns)} metrics")
    
    # Step 6: Map to ASPICE indicators
    print("\n[6/6] Mapping to ASPICE indicators...")
    df_aspice = map_to_aspice_indicators(df_metrics)
    print(f"  ✓ Generated ASPICE indicators")
    
    # Step 7: Combine and save
    print("\n[7/7] Saving processed data...")
    df_final = pd.concat([df_metrics, df_aspice], axis=1)
    
    # Save to CSV
    output_file = os.path.join(OUTPUT_PATH, 'processed_metrics.csv')
    df_final.to_csv(output_file, index=False)
    print(f"  ✓ Data saved to {output_file}")
    
    # Summary statistics
    print("\n" + "=" * 60)
    print("SUMMARY STATISTICS")
    print("=" * 60)
    print(f"Total commits extracted: {len(df_commits_all)}")
    print(f"Total issues extracted: {len(df_issues_all)}")
    print(f"Total CI/CD records: {len(df_ci_all)}")
    print(f"Total test records: {len(df_tests_all)}")
    print(f"Total metrics computed: {len(df_metrics.columns)}")
    print(f"Readiness distribution:")
    print(f"  High: {df_aspice['aspice_readiness_level'].value_counts().get('High', 0)}")
    print(f"  Moderate: {df_aspice['aspice_readiness_level'].value_counts().get('Moderate', 0)}")
    print(f"  Low: {df_aspice['aspice_readiness_level'].value_counts().get('Low', 0)}")
    print("=" * 60)
    
    return df_final

if __name__ == "__main__":
    df_final = main()
